# Backend — NWB Workout API

# Neon Postgres connection string (free tier: https://neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_CALLBACK_URL=https://me.93.fyi/auth/callback

# Secret for signing tokens (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-in-production

# Where the frontend lives (for CORS + redirect after login)
FRONTEND_URL=https://nfit.93.fyi
