# Backend — NWB Workout API
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The URL GitHub redirects to after OAuth — your domain
AUTH_CALLBACK_URL=https://me.93.fyi/auth/callback
# Secret for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-in-production
# Where the frontend lives (for CORS + redirect after login)
FRONTEND_URL=https://nfit.93.fyi
# Optional: Hevy API key (users can also supply their own)
HEVY_API_KEY=
